{
  "name": "echochamber",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest",
    "test:run": "vitest run",
    "auth:migrate": "auth migrate --config src/lib/server/auth.ts",
    "seed": "bun scripts/seed.ts"
  },
  "dependencies": {
    "better-auth": "^1.7.10",
    "better-sqlite3": "^13.0.3",
    "kysely": "^0.29.6",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@iconify-json/lucide": "^1.2.145",
    "@iconify-json/simple-icons": "^1.2.100",
    "@internationalized/date": "^3.12.0",
    "@lucide/svelte": "^1.58.0",
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24",
    "auth": "1.7.10",
    "bits-ui": "^2.18.0",
    "cn": "^0.3.0",
    "mode-watcher": "^1.1.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "shadcn-svelte": "^1.7.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.6.0",
    "svelte-sonner": "^1.2.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "unplugin-icons": "^24.0.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  }
}
